<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/tbDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="0dp"
        android:orientation="horizontal"
        android:weightSum="12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <TextView
            android:id="@+id/tv_dname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:fontFamily="@font/roboto_medium"
            android:padding="4dp"
            android:gravity="center"
            android:text=""
            android:background="@drawable/border_around"
            android:textColor="@color/black"
            android:textSize="12sp"

            />

        <TextView
            android:id="@+id/tv_odoctor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.5"
            android:fontFamily="@font/roboto_medium"
            android:background="@drawable/border_around"
            android:padding="4dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/black"
            android:textSize="12sp"

            />

        <TextView
            android:id="@+id/tv_subdate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:background="@drawable/border_around"
            android:fontFamily="@font/roboto_medium"
            android:padding="4dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/black"
            android:textSize="12sp"

            />

        <TextView
            android:id="@+id/tv_rxdate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:background="@drawable/border_around"
            android:fontFamily="@font/roboto_medium"
            android:padding="4dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/black"
            android:textSize="12sp"

            />

        <TextView
            android:id="@+id/tv_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.5"
            android:background="@drawable/border_around"
            android:fontFamily="@font/roboto_medium"
            android:padding="4dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/black"
            android:textSize="12sp"

            />
        <ImageView
           android:id="@+id/iv_image"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@drawable/border_around"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:padding="2dp"
            android:text="Rx Image"
            android:src="@drawable/ic_imgbg"

            />


    </LinearLayout>

</RelativeLayout>