<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/masterLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UI.Attendance.AttendanceActivity">

    <LinearLayout
        android:id="@+id/toll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_custom"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:background="@color/color_main_deep"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:theme="@style/ToolbarTheme"

            >

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/toolbar_title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="30dp"
                    android:layout_toStartOf="@+id/attRefresh"
                    android:fontFamily="@font/roboto_medium"
                    android:gravity="center|start"
                    android:text="@string/string_daily_attendance"
                    android:textColor="@android:color/white"
                    android:textSize="20sp" />

                <ImageView
                    android:id="@+id/attRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:paddingEnd="10dp"
                    android:src="@android:drawable/ic_popup_sync" />
            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toll"
        android:background="@color/white"
        android:orientation="vertical"
        android:weightSum="8">
          <fragment
              android:id="@+id/map"
              android:name="com.google.android.gms.maps.SupportMapFragment"
              android:layout_width="match_parent"
              android:layout_height="0dp"
              android:layout_weight="5" />


        <LinearLayout
            android:id="@+id/punchInDIv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-5dp"
            android:layout_weight="3"
            android:background="@drawable/top_round_corner"
            android:backgroundTint="@color/color_layout_bg"
            android:elevation="10dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/punchInDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="@color/black"
                    android:textSize="16sp"

                    />
                <TextView
                    android:id="@+id/punchInTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="@color/color_main"
                    android:textSize="16sp"

                    />
            </LinearLayout>



            <LinearLayout
                android:id="@+id/shiftDIv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="10dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/morning"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/shape_oval_white_sole"
                    android:elevation="4dp"
                    android:padding="5dp"
                    android:src="@drawable/ic_sun"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/color_main2" />

                <ImageView
                    android:id="@+id/evening"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/shape_oval_black_sole"
                    android:elevation="2dp"
                    android:padding="5dp"
                    android:src="@drawable/ic_moon"
                    app:tint="@color/white"
                    tools:layout_editor_absoluteX="6dp"
                    tools:layout_editor_absoluteY="6dp" />

                <LinearLayout
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/cell_shape"
                    android:backgroundTint="@color/white"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:paddingStart="10dp"


                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_medium"
                        android:text="Tour Type"
                        android:textColor="@color/black"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spinner_station"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_marginEnd="8dp"
                        android:elevation="10sp"
                        tools:ignore="SpeakableTextPresentCheck" />


                </LinearLayout>
                <!--     <Spinner
                         android:id="@+id/spinner_station"
                         android:layout_width="100dp"
                         android:layout_height="wrap_content"
                         android:layout_marginStart="10dp"
                         android:layout_gravity="center"
                         android:background="@drawable/shape_rect_border"
                         tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />-->


            </LinearLayout>

            <EditText
                android:id="@+id/et_in_place"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:autofillHints=""
                android:hint="@string/work_place"
                android:inputType="textPersonName|textCapWords"
                tools:ignore="TouchTargetSizeCheck,TouchTargetSizeCheck,TouchTargetSizeCheck,TouchTargetSizeCheck,TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btnPunchIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@color/color_main_deep"
                android:paddingLeft="25dp"
                android:paddingTop="6dp"
                android:paddingRight="25dp"
                android:paddingBottom="6dp"

                android:text="@string/punch_in"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/punchOutDiv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-5dp"
            android:layout_weight="3"
            android:background="@drawable/top_round_corner"
            android:backgroundTint="@color/color_layout_bg"
            android:elevation="10dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="invisible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/punchOutDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_medium"
                    android:gravity="start"
                    android:text=""
                    android:textColor="@color/black"
                    android:textSize="18sp"

                    />

                <TextView
                    android:id="@+id/punchOutTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_medium"
                    android:gravity="end"
                    android:text=""
                    android:textColor="@color/color_main"
                    android:textSize="18sp"

                    />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/shiftDIvout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="10dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/morningout"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/shape_oval_white_sole"
                    android:elevation="4dp"
                    android:padding="5dp"
                    android:src="@drawable/ic_sun"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/color_main2" />

                <ImageView
                    android:id="@+id/eveningout"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/shape_oval_black_sole"
                    android:elevation="2dp"
                    android:padding="5dp"
                    android:src="@drawable/ic_moon"
                    app:tint="@color/white"
                    tools:layout_editor_absoluteX="6dp"
                    tools:layout_editor_absoluteY="6dp" />
                <!-- <LinearLayout
                     android:layout_width="200dp"
                     android:layout_height="wrap_content"
                     android:layout_marginLeft="8dp"
                     android:layout_marginRight="8dp"
                     android:background="@drawable/cell_shape"
                     android:backgroundTint="@color/white"
                     android:elevation="5dp"
                     android:orientation="vertical"
                     android:paddingStart="10dp"
                     >

                     <TextView
                         android:layout_width="wrap_content"
                         android:layout_height="0dp"
                         android:layout_weight="1"
                         android:text="Tour Type"
                         android:textColor="@color/black"
                         android:textSize="12sp"
                         android:fontFamily="@font/roboto_medium" />

                     <Spinner
                         android:id="@+id/spinner_station_out"
                         android:layout_width="match_parent"
                         android:layout_height="30dp"
                         android:layout_marginEnd="8dp"
                         android:elevation="10sp"
                         tools:ignore="SpeakableTextPresentCheck" />


                 </LinearLayout>-->


            </LinearLayout>

            <EditText
                android:id="@+id/et_out_place"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:autofillHints=""
                android:hint="@string/work_place"
                android:inputType="textPersonName|textCapWords" />


            <Button
                android:id="@+id/btnPunchOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@color/color_main_deep"
                android:paddingLeft="25dp"
                android:paddingTop="6dp"
                android:paddingRight="25dp"
                android:paddingBottom="6dp"
                android:text="@string/punch_out"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/divAttCompleted"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-5dp"
            android:layout_weight="3"
            android:background="@drawable/top_round_corner"
            android:elevation="10dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="invisible">

            <TextView
                android:id="@+id/dTXT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:textColor="@color/color_main"
                android:textSize="25sp"

                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/your_attendance_is_completed"
                android:textColor="@color/color_main"
                android:textSize="20sp"


                />

        </LinearLayout>
    </LinearLayout>
</RelativeLayout>