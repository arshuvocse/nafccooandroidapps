<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:id="@+id/div_plan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.95">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="@drawable/bordar_around_attendbg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@android:color/black"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="center"
                    android:text="Attend"
                    android:textColor="@android:color/black"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:weightSum="3"
                android:background="@drawable/bordar_around_attendbg"
                android:gravity="center"
                android:orientation="vertical"

                >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="2"
                    android:fontFamily="@font/roboto_light"
                    android:background="@drawable/bordar_around_attend2bg"
                    android:gravity="center"
                    android:text="Attendance Proper?"
                    android:textColor="@android:color/black"
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_light"
                    android:background="@drawable/bordar_around_attendbg"
                    android:gravity="center"
                    android:text="Gate-Up?"
                    android:textColor="@android:color/black"
                    android:textSize="12sp" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="-1dp"
            android:layout_weight="1.3"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:weightSum="6">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bordar_around_attend2bg"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="end"
                    android:padding="2dp"
                    android:text="Atten. Submitted?"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="-1dp"
                    android:layout_weight="1"
                    android:background="@drawable/bordar_around_attend2bg"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="end"
                    android:padding="2dp"
                    android:text="Atten. OTIP?"
                    android:textColor="@color/black"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="-1dp"
                    android:layout_weight="1"
                    android:background="@drawable/bordar_around_attend2bg"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="end"
                    android:padding="2dp"
                    android:text="Followed MWS?"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="-1dp"
                    android:layout_weight="1"
                    android:background="@drawable/bordar_around_attend2bg"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="end"
                    android:padding="2dp"
                    android:text="Reported at Dr Point?"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="-1dp"
                    android:layout_weight="1"
                    android:background="@drawable/bordar_around_attendbg"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="end"
                    android:padding="2dp"
                    android:text="Physical Grooming"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="-1dp"
                    android:layout_weight="1"
                    android:background="@drawable/bordar_around_attendbg"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="end"
                    android:padding="2dp"
                    android:text="Dressed-up Properly?"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="-1dp"
            android:layout_weight=".55"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:weightSum="6">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="-1dp"
                    android:layout_weight="1"
                    android:background="@drawable/bordar_around_attend2bg"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="end"
                    android:padding="2dp"
                    android:text="2"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="-1dp"
                    android:layout_weight="1"
                    android:background="@drawable/bordar_around_attend2bg"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="end"
                    android:padding="2dp"
                    android:text="2"
                    android:textColor="@color/black"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="-1dp"
                    android:layout_weight="1"
                    android:background="@drawable/bordar_around_attend2bg"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="end"
                    android:padding="2dp"
                    android:text="2"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bordar_around_attend2bg"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="end"
                    android:padding="2dp"
                    android:text="2"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="-1dp"
                    android:layout_weight="1"
                    android:background="@drawable/bordar_around_attendbg"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="end"
                    android:padding="2dp"
                    android:text="2"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="-1dp"
                    android:layout_weight="1"
                    android:background="@drawable/bordar_around_attendbg"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="end"
                    android:padding="2dp"
                    android:text="2"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="-1dp"
            android:layout_weight="1.2"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="-1dp"
                    android:layout_weight="1"
                    android:background="@drawable/bordar_around_attend2bg"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="end"
                    android:hint="----"
                    android:padding="2dp"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bordar_around_attend2bg"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="end"
                    android:hint="----"
                    android:padding="2dp"
                    android:textColor="@color/black"
                    android:textSize="11sp" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="-1dp"
                    android:layout_weight="1"
                    android:background="@drawable/bordar_around_attend2bg"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="end"
                    android:hint="----"
                    android:padding="2dp"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="-1dp"
                    android:layout_weight="1"
                    android:background="@drawable/bordar_around_attend2bg"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="end"
                    android:hint="----"
                    android:padding="2dp"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="-1dp"
                    android:layout_weight="1"
                    android:background="@drawable/bordar_around_attendbg"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="end"
                    android:hint="----"
                    android:padding="2dp"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="-1dp"
                    android:layout_weight="1"
                    android:background="@drawable/bordar_around_attendbg"
                    android:fontFamily="@font/roboto_light"
                    android:gravity="end"
                    android:hint="----"
                    android:padding="2dp"
                    android:textColor="@android:color/black"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>