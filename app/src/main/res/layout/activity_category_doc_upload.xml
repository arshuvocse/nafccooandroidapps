<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECEFF1"
    android:orientation="vertical"
    tools:context=".UI.CategoryRequest.ActivityCategoryDocUpload">

    <include
        android:id="@+id/header"
        layout="@layout/layout_catreq_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="@color/color_main_deep"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#263238"
                    android:textSize="13sp" />
            </LinearLayout>

            <include
                android:id="@+id/doc_shop"
                layout="@layout/item_category_doc" />

            <include
                android:id="@+id/doc_nid"
                layout="@layout/item_category_doc" />

            <include
                android:id="@+id/doc_trade"
                layout="@layout/item_category_doc" />

            <include
                android:id="@+id/doc_drug"
                layout="@layout/item_category_doc" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="* চারটি ডকুমেন্টই বাধ্যতামূলক। সব আপলোড না হলে রিকোয়েস্ট সাবমিট হবে না।"
                android:textColor="#546E7A"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_submit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="12dp"
        android:backgroundTint="@color/color_main_deep"
        android:enabled="false"
        android:fontFamily="@font/roboto_bold"
        android:text="Submit Request"
        android:textColor="@color/white" />
</LinearLayout>
