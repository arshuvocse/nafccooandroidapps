<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_main_shadow"
    tools:context=".UI.DoctorDashBoard.DCR.ActivityDCR">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_custom"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@color/color_main_deep"
        android:elevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:theme="@style/ToolbarTheme">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:fontFamily="@font/roboto_medium"
                android:text="Make Call"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/iv_sync"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_sync_grey"
                app:tint="@color/white"/>
        </RelativeLayout>

    </androidx.appcompat.widget.Toolbar>
    <ScrollView
        android:id="@+id/masterLayoutId"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_custom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1"
                    android:background="@color/white"
                    android:elevation="3dp"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/roboto_medium"
                        android:gravity="center"
                        android:text="Date : "
                        android:textColor="@color/color_main_deep"
                        android:textSize="14sp"


                        />

                    <TextView
                        android:id="@+id/tv_dcrDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_medium"
                        android:gravity="start"
                        android:hint="@string/dash"
                        android:textColor="@color/black"
                        android:textSize="14sp"

                        />

                    <ImageView
                        android:id="@+id/iv_datepicker"
                        android:visibility="gone"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/color_main_deep" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_plan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1"
                    android:background="@color/white"
                    android:elevation="3dp"
                    android:padding="7dp">

                    <Spinner
                        android:id="@+id/spinnerPlanned"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        tools:ignore="SpeakableTextPresentCheck,SpeakableTextPresentCheck,SpeakableTextPresentCheck" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_planed"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1"
                    android:background="@color/white"
                    android:elevation="3dp"
                    android:padding="7dp">

                    <TextView
                        android:id="@+id/planned"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textSize="12sp"
                        android:fontFamily="@font/roboto_medium"
                        tools:ignore="SpeakableTextPresentCheck,SpeakableTextPresentCheck,SpeakableTextPresentCheck" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/til_doctor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="2dp"
                android:background="@color/white"
                android:elevation="3dp"
                android:padding="7dp">
                <com.toptoche.searchablespinnerlibrary.SearchableSpinner
                    android:id="@+id/act_doctor"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/shape_rect_border"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:spinnerMode="dialog" />
            </LinearLayout>

           <!-- <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_doctor"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@color/white"
                android:visibility="visible">

                <AutoCompleteTextView
                    android:id="@+id/act_doctor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:completionThreshold="1" />
            </com.google.android.material.textfield.TextInputLayout>-->
            <LinearLayout
                android:id="@+id/ll_call_stuff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="4dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:background="@color/white"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_medium"
                        android:text="Call Time"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_callTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@color/white"
                            android:hint="@string/dott"
                            android:padding="4dp" />

                        <ImageView
                            android:id="@+id/iv_callclock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/color_main_deep" />
                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="1dp"
                    android:layout_weight="1"
                    android:background="@color/white"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/plabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_medium"
                        android:text="Call Type"
                        android:textColor="@color/black"
                        android:textSize="14sp" />


                    <RadioGroup
                        android:id="@+id/rg_CallType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rb_self"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/color_main_deep"
                            android:fontFamily="@font/roboto_medium"
                            android:text="Self"
                            android:checked="true"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/rb_joint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:buttonTint="@color/color_main_deep"
                            android:fontFamily="@font/roboto_medium"
                            android:text="Joint"
                            android:textSize="14sp" />
                    </RadioGroup>

                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/ll_visitedwith"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="4dp"
                android:background="@color/white"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/visitedtag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Call with"
                    android:textColor="@color/black"
                    android:textSize="14sp"

                    />

             <!--   <ImageView
                    android:id="@+id/callwithAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_add_" />-->

                <TextView
                    android:id="@+id/visitedstr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/visitedtag"
                    android:layout_marginTop="5dp"
                    android:padding="5dp"
                    android:textColor="@color/black"
                    android:visibility="gone"

                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/visitedtag"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"

                    android:layout_marginStart="14dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="15dp"
                    android:orientation="horizontal">
                    <CheckBox
                        android:id="@+id/ckd_am"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/color_main_deep"
                        android:fontFamily="@font/roboto_medium"
                        android:text="ABM"
                        android:textColor="@color/black"
                        android:textSize="14sp" />
                    <CheckBox
                        android:id="@+id/ckd_rm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:buttonTint="@color/color_main_deep"
                        android:fontFamily="@font/roboto_medium"
                        android:text="RBM"
                        android:textColor="@color/black"
                        android:textSize="14sp" />
                    <CheckBox
                        android:id="@+id/ckd_cbm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:buttonTint="@color/color_main_deep"
                        android:fontFamily="@font/roboto_medium"
                        android:text="CBM"
                        android:textColor="@color/black"
                        android:textSize="14sp" />
                    <CheckBox
                        android:id="@+id/ckd_ho"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:buttonTint="@color/color_main_deep"
                        android:fontFamily="@font/roboto_medium"
                        android:text="HO"
                        android:textColor="@color/black"
                        android:textSize="14sp" />


                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:id="@+id/ll_doccalltype"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:background="@color/white"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="6dp"
                android:visibility="visible">

                <RadioGroup
                    android:id="@+id/rg_drCallType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_single"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/color_main_deep"
                        android:fontFamily="@font/roboto_medium"
                        android:text="Single Call"
                        android:checked="true"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:buttonTint="@color/color_main_deep"
                        android:fontFamily="@font/roboto_medium"
                        android:text="Group Call"
                        android:textSize="14sp" />
                </RadioGroup>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_priority"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="6dp"
                android:background="@color/white"
                android:orientation="vertical"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/roboto_bold"
                        android:padding="2dp"
                        android:text="@string/priority_brand_wise_promo_selection"
                        android:textColor="@color/color_main3deep"
                        android:textSize="16sp"/>


                    <ImageButton
                        android:id="@+id/pop_stock"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:backgroundTint="@color/color_main_shadow"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_box"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="1dp"
                        android:background="@color/white"
                        android:orientation="vertical"
                        android:weightSum="6">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:background="@color/color_main3"
                            android:fontFamily="@font/roboto_medium"
                            android:padding="2dp"
                            android:text="Priority"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/color_main3" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <CheckBox
                                android:id="@+id/p1"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:fontFamily="@font/roboto_medium"
                                android:gravity="center"
                                android:text="@string/p1"
                                android:buttonTint="@color/color_main3deep"
                                android:textColor="@color/black"
                                android:textSize="14sp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/color_main3" />

                            <CheckBox
                                android:id="@+id/p2"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:fontFamily="@font/roboto_medium"
                                android:gravity="center"
                                android:text="P2"
                                android:buttonTint="@color/color_main3deep"
                                android:textColor="@color/black"
                                android:textSize="14sp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/color_main3" />

                            <CheckBox
                                android:id="@+id/p3"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:fontFamily="@font/roboto_medium"
                                android:gravity="center"
                                android:text="P3"
                                android:buttonTint="@color/color_main3deep"
                                android:textColor="@color/black"
                                android:textSize="14sp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/color_main3" />

                            <CheckBox
                                android:id="@+id/p4"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:fontFamily="@font/roboto_medium"
                                android:gravity="center"
                                android:text="P4"
                                android:buttonTint="@color/color_main3deep"
                                android:textColor="@color/black"
                                android:textSize="14sp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/color_main3" />

                            <CheckBox
                                android:id="@+id/p5"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:fontFamily="@font/roboto_medium"
                                android:gravity="center"
                                android:text="@string/p5"
                                android:buttonTint="@color/color_main3deep"
                                android:textColor="@color/black"
                                android:textSize="14sp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/color_main3" />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="1dp"
                        android:layout_weight="1.3"
                        android:background="@color/white"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:background="@color/color_main_deep"
                            android:fontFamily="@font/roboto_medium"
                            android:padding="2dp"
                            android:text="Brand"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="14sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/color_main_deep" />

                        <Spinner
                            android:id="@+id/spinnerProduct1"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            tools:ignore="SpeakableTextPresentCheck" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/color_main_deep" />

                        <Spinner
                            android:id="@+id/spinnerProduct2"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            tools:ignore="SpeakableTextPresentCheck" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/color_main_deep" />

                        <Spinner
                            android:id="@+id/spinnerProduct3"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            tools:ignore="SpeakableTextPresentCheck" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/color_main_deep" />

                        <Spinner
                            android:id="@+id/spinnerProduct4"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            tools:ignore="SpeakableTextPresentCheck" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/color_main_deep" />

                        <Spinner
                            android:id="@+id/spinnerProduct5"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            tools:ignore="SpeakableTextPresentCheck" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/color_main_deep" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@color/white"
                        android:orientation="vertical">
                        <TextView     android:layout_width="match_parent"    android:layout_height="42dp"

                            android:fontFamily="@font/roboto_medium"
                            android:padding="2dp"
                            android:background="@color/lightGrey"
                            android:gravity="center"
                            android:textColor="@color/black"
                            android:textSize="14sp" android:text="Select Product"></TextView>


                 <!--       <include
                            android:id="@+id/p"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            layout="@layout/component_promo" />-->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_menu_promo"
                            android:layout_width="match_parent" android:visibility="gone"
                            android:layout_height="42dp"
                            />

                    <!--    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/purple_700"
                            android:fontFamily="@font/roboto_medium"
                            android:padding="2dp"
                            android:text="Promo"
                            android:textColor="@color/white"
                            android:textSize="14sp" />-->

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/purple_700" />

                        <LinearLayout
                            android:id="@+id/p1promo"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:orientation="vertical"
                            android:layout_gravity="center"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent">

                            <Spinner
                                android:id="@+id/spinnerProductSelect"
                                android:layout_width="match_parent"
                                android:layout_height="42dp"
                                tools:ignore="SpeakableTextPresentCheck" />
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_p1_promo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" android:visibility="gone"
                                app:layout_constraintBottom_toBottomOf="parent"
                                />
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/purple_700" />
