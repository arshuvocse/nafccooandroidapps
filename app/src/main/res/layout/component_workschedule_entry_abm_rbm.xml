                            android:textColor="@color/black"
                            android:textSize="14sp"

                            />

                        <ImageView
                            android:id="@+id/eeclock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/purple_700" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
