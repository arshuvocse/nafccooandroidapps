<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:endColor="@color/color_main"
                android:startColor="@color/color_main_deep" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <item
        android:bottom="42dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#30FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
