<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Gradient Capsule -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="#0D9488"
                android:centerColor="#0F766E"
                android:endColor="#005A59"
                android:type="linear" />
        </shape>
    </item>
    <!-- Subtle top gloss highlight for modern glass finish -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="18dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="18dp"
                android:topRightRadius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
