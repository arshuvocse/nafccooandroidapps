<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="1dp">
        <shape>
            <solid android:color="#18032C48" />
        </shape>
    </item>

    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#F4F8FCFF"
                android:startColor="#FFFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#E7F0EE" />
        </shape>
    </item>

    <item android:bottom="45dp">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#5AFFFFFF" />
        </shape>
    </item>
</layer-list>
